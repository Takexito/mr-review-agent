{
  "name": "mr-review-agent",
  "version": "0.1.0",
  "description": "GitLab MR-агент на подписке Codex (mention-триггер @codex review / @codex <вопрос>)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@gitbeaker/rest": "^40.5.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "bullmq": "^5.34.0",
    "execa": "^9.5.2",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "pino": "^9.5.0",
    "yaml": "^2.9.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
