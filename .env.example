# Настройки сервиса — в service.yaml (шаблон service.example.yaml). Здесь только секреты,
# на которые service.yaml ссылается через secret:NAME, и временные переменные.

# --- Секреты (имена — те, что указаны в service.yaml) ---
# server.webhookSecret. Сгенерируй: openssl rand -hex 32
WEBHOOK_SECRET=change-me
# engines.codex.bot.token — PAT бот-юзера codex, scope=api.
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
# gitlab.cloneToken (необязательно): scope=read_repository, роль Reporter.
GITLAB_CLONE_TOKEN=
# engines.claude.bot.token и engines.claude.oauthToken (`claude setup-token`), если включён claude.
CLAUDE_GITLAB_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN=

# --- Временные: уходят с переходом на коннекторы и смежные репозитории ---
# (docs/plan/connectors-and-profiles.md, шаги 2–3)

# Токен, который получает САМ АГЕНТ, чтобы дочитывать описание MR и треды целиком
# и открывать ссылки GitLab из требований. scope=read_api. НАСТОЯТЕЛЬНО: project access
# token на конкретный проект — комментарии MR пишут люди, это канал prompt injection.
# Пусто = агент видит только тот срез тредов, что вклеен в промпт.
GITLAB_READ_TOKEN=
# MCP-сервер ctxmcp у codex. Без default_tools_approval_mode="approve" (шаг 2 плана)
# `codex exec` отклоняет каждый вызов — не включать.
CODEX_MCP_ENABLED=false
# On-demand доступ codex к Linear через shell-CLI. Требует сети, поэтому при true песочница
# переключается с read-only на workspace-write + network_access: агент пишет в свой
# одноразовый worktree и TMPDIR и ходит в сеть. Кэш репозиториев (git.cacheDir) держи вне TMPDIR.
# false → read-only, требования раскладываются на диск в <jobdir>/linear.
CODEX_ONDEMAND_LINEAR=true
# Linear personal API key (read issues). Пусто = SPEC без критериев приёмки и спеки.
LINEAR_API_KEY=
LINEAR_API_URL=https://api.linear.app/graphql
# Репо с документацией и контрактами; боту нужен ≥Reporter.
DOCS_REPO_PROJECT=acme/docs
DOCS_REPO_REF=master
