# --- HTTP ---
PORT=8080
LOG_LEVEL=info

# --- Webhook ---
# Секрет, который GitLab шлёт в заголовке X-Gitlab-Token. Сгенерируй: openssl rand -hex 32
WEBHOOK_SECRET=change-me

# --- GitLab ---
GITLAB_HOST=https://gitlab.com
# PAT бот-юзера, scope=api. От его имени постятся комменты (и клонятся репо, если
# GITLAB_CLONE_TOKEN не задан).
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
# Необязательно: отдельный токен только для clone/fetch. Хватает scope=read_repository
# и роли Reporter — постинг им не выполняется. Пусто = используется GITLAB_TOKEN.
GITLAB_CLONE_TOKEN=
# Токен, который получает САМ АГЕНТ, чтобы дочитывать описание MR и треды целиком
# (`gitlab mr-info` / `mr-notes` у codex, инструменты gitlab_mr_* у claude).
# Им же агент открывает ссылки GitLab из требований: задачи, MR, файлы, вложения
# (`gitlab fetch` / `gitlab_fetch_url`) — в пределах проектов, доступных владельцу токена.
# scope=read_api. НАСТОЯТЕЛЬНО: заводи project access token на конкретный проект,
# а не personal PAT — у агента есть сеть, а комментарии MR пишут люди, то есть это
# канал prompt injection. Project-токен ограничивает ущерб одним проектом.
# Пусто = агент видит только тот срез тредов, что вклеен в промпт (безопасный дефолт).
GITLAB_READ_TOKEN=
# GitLab-username бота — то, что тегают: @codex
BOT_USERNAME=codex
# Разрешённые проекты (path_with_namespace через запятую). Пусто = все.
PROJECT_ALLOWLIST=acme/android-app

# --- Codex (подписка) ---
# CODEX_HOME указывает на volume с auth.json (переиспользованный сиат).
CODEX_HOME=/data/codex
# Путь к бинарю codex внутри контейнера (обычно просто "codex").
CODEX_BIN=codex
# Необязательно: пин модели и reasoning (иначе берётся дефолт config.toml).
CODEX_MODEL=
CODEX_REASONING=
# Таймаут одного прогона codex, мс. Обход большого MR — это десятки tool-call'ов.
CODEX_TIMEOUT_MS=1800000
# Подключать ли MCP-сервер ctxmcp к codex. НЕ ВКЛЮЧАТЬ без проверки: `codex exec`
# регистрирует сервер, но авто-отклоняет каждый tools/call под песочницей
# («user cancelled MCP tool call») — проверено на 0.145.0 и 0.147.0. Linear для codex
# раскладывается на диск в <jobdir>/linear. Флаг оставлен на случай починки апстримом.
CODEX_MCP_ENABLED=false
# On-demand доступ codex к Linear через shell-CLI (`linear issue PRJ-137`) по ходу ревью.
# Включено (нужен LINEAR_API_KEY). Требует сети, а её codex даёт только в workspace-write —
# поэтому при true песочница переключается с read-only на workspace-write + network_access.
# Что это значит: агент может писать в свой ОДНОРАЗОВЫЙ worktree и ходить в сеть.
# Секреты бота в его окружение при этом не попадают (явный allowlist, см. src/agent/env.ts),
# а bare-кэш /data/repos остаётся защищён от записи — но только пока он ВНЕ TMPDIR.
# false → вернётся read-only, а требования разложатся на диск в <jobdir>/linear.
CODEX_ONDEMAND_LINEAR=true

# --- Claude Code движок (второй ревьюер, подписка Pro/Max) ---
# Включается автоматически, если заданы CLAUDE_BOT_USERNAME + CLAUDE_GITLAB_TOKEN.
# Явно выключить: CLAUDE_ENABLED=false.
CLAUDE_ENABLED=
# GitLab-username второго бота — то, что тегают: @claude_bot
CLAUDE_BOT_USERNAME=
# PAT бот-юзера @claude_bot, scope=api. Комменты Claude постятся от его имени.
CLAUDE_GITLAB_TOKEN=
# Годовой OAuth-токен подписки: получить `claude setup-token` на залогиненной машине.
CLAUDE_CODE_OAUTH_TOKEN=
# Путь к бинарю claude в контейнере (обычно просто "claude").
CLAUDE_BIN=claude
# Модель: sonnet (дефолт) | opus | fable.
CLAUDE_MODEL=sonnet
# Read-only режим: dontAsk + белый список read-инструментов (правки/сеть запрещены).
CLAUDE_PERMISSION_MODE=dontAsk
# mcp__ctxmcp — префикс сервера, разрешает все его инструменты (linear_*).
CLAUDE_ALLOWED_TOOLS=Read,Glob,Grep,Bash(git diff *),Bash(git log *),Bash(git show *),Bash(git ls-files *),Bash(git blame *),mcp__ctxmcp
# Таймаут одного прогона claude, мс.
CLAUDE_TIMEOUT_MS=1800000

# --- Git и режим диффа ---
# ВАЖНО: держи кэш вне TMPDIR. При CODEX_ONDEMAND_LINEAR=true песочница агента
# разрешает запись в TMPDIR, и кэш в /tmp стал бы доступен ему на запись.
REPOS_CACHE_DIR=/data/repos
# Порог переключения inline → agentic (НЕ размер усечения: усечения больше нет).
# Дифф меньше порога уезжает в промпт целиком; больше — агент читает его сам пофайлово
# из worktree и отчитывается, какие файлы просмотрел.
MAX_DIFF_BYTES=400000
# Второй, более дешёвый гейт: по числу изменённых строк, без материализации диффа.
MAX_DIFF_LINES=20000
# Дочитывание в agentic-режиме: файлы, которые агент пропустил, бот отдаёт ему повторным
# прогоном той же оси. Прогонов на ось (0 — выключить) и файлов в одном прогоне.
COVERAGE_FOLLOWUP_RUNS=5
COVERAGE_FOLLOWUP_BATCH=40

# --- Очередь ---
# Сколько джоб идёт параллельно. Сиат подписки общий с живым разработчиком — при
# учащении rate-limit откатывай в 1. Операции над bare-кэшем сериализуются мьютексом.
QUEUE_CONCURRENCY=2

# --- Контекст требований: Linear + docs-repo ---
# Linear personal API key (scope: read issues). Пусто = SPEC без критериев приёмки и спеки.
# Claude ходит в Linear on-demand через MCP ctxmcp; codex получает раскладку на диске.
LINEAR_API_KEY=
LINEAR_API_URL=https://api.linear.app/graphql
# Репо с документацией и канон. API-контрактами. Боту нужен ≥Reporter.
# Выкладывается целиком в <jobdir>/docs-repo — агент грепает всю доку, а не два файла.
DOCS_REPO_PROJECT=acme/docs
DOCS_REPO_REF=master

# --- Redis (свой, не backend) ---
REDIS_URL=redis://redis:6379
