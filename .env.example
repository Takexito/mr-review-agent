# Настройки сервиса — в service.yaml (шаблон service.example.yaml). Здесь только секреты,
# на которые service.yaml ссылается через secret:NAME, и временные переменные.

# --- Секреты (имена — те, что указаны в service.yaml) ---
# server.webhookSecret. Сгенерируй: openssl rand -hex 32
WEBHOOK_SECRET=change-me
# engines.codex.bot.token — PAT бот-юзера codex, scope=api.
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
# gitlab.cloneToken (необязательно): scope=read_repository, роль Reporter.
GITLAB_CLONE_TOKEN=
# engines.claude.bot.token и engines.claude.oauthToken (`claude setup-token`), если включён claude.
CLAUDE_GITLAB_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN=

# Токены коннекторов (connectors.*.env / headers), только на чтение:
# GITLAB_MCP_TOKEN=   # scope read_api, project/group access token
# LINEAR_MCP_TOKEN=   # Linear API key с правом Read

# --- Временные: уходят с новой предзагрузкой и смежными репозиториями ---
# (docs/plan/connectors-and-profiles.md, шаги 3–4)

# Linear API key, которым БОТ скачивает задачу-постановку до запуска движка (не агент).
# Пусто = задачи Linear не скачиваются.
LINEAR_API_KEY=
LINEAR_API_URL=https://api.linear.app/graphql
# Репо с документацией и контрактами; боту нужен ≥Reporter.
DOCS_REPO_PROJECT=acme/docs
DOCS_REPO_REF=master
